{
  "name": "skilled-potato",
  "version": "1.0.0",
  "private": true,
  "description": "CLI that installs curated Claude Code skills from this repo into a project's .claude/skills/",
  "bin": {
    "potato": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "bun run src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "generate-manifest": "bun run scripts/generate-manifest.ts"
  },
  "dependencies": {
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^20.14.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
